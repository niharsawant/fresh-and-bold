<article class="portfolio-case-study">
    <a class="portfolio-case-study-details" href="{{url}}">
        <div class="portfolio-case-study-copy">
            <h3>{{title}}</h3>
            <p>{{excerpt words="32"}}</p>
        </div>
        <div class="portfolio-case-study-author">
            {{#if primary_author.profile_image}}
            <img src="{{primary_author.profile_image}}" alt="" />
            {{/if}}
            <strong>{{primary_author.name}}</strong>
        </div>
    </a>
    <a class="portfolio-case-study-image" href="{{url}}" aria-label="Read {{title}}">
        {{#if feature_image}}
            <img src="{{feature_image}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" />
        {{/if}}
    </a>
</article>
