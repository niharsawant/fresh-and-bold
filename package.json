{
    "name": "fresh-and-bold",
    "description": "A minimum, image-centric theme for Ghost built on top of London theme.",
    "demo": "https://nihar.sawant.me",
    "version": "1.3.4",
    "engines": {
        "ghost": ">=4.0.0"
    },
    "license": "MIT",
    "screenshots": {
        "desktop": "assets/screenshot-desktop.jpg"
    },
    "scripts": {
        "dev": "gulp",
        "zip": "gulp zip",
        "test": "gscan .",
        "test:ci": "gscan --fatal --verbose .",
        "pretest": "gulp build",
        "preship": "yarn test",
        "ship": "STATUS=$(git status --porcelain); echo $STATUS; if [ -z \"$STATUS\" ]; then yarn version && git push --follow-tags; fi"
    },
    "author": {
        "name": "Nihar Sawant",
        "email": "nihar.sawant@gmail.com",
        "url": "https://nihar.sawant.me"
    },
    "gpm": {
        "type": "theme",
        "categories": [
            "Minimal",
            "Magazine"
        ]
    },
    "keywords": [
        "ghost",
        "theme",
        "ghost-theme"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/niharsawant/fresh-and-bold.git"
    },
    "bugs": "https://github.com/niharsawant/fresh-and-bold/issues",
    "browserslist": [
        "defaults"
    ],
    "devDependencies": {
        "autoprefixer": "^10.3.7",
        "cssnano": "^5.0.8",
        "gscan": "^4.9.0",
        "gulp": "4.0.2",
        "gulp-concat": "^2.6.1",
        "gulp-livereload": "4.0.2",
        "gulp-postcss": "^9.0.0",
        "gulp-sourcemaps": "2.6.5",
        "gulp-uglify": "3.0.2",
        "gulp-util": "3.0.8",
        "gulp-watch": "5.0.1",
        "gulp-zip": "5.0.1",
        "postcss": "^8.3.11",
        "postcss-color-function": "4.1.0",
        "postcss-custom-properties": "8.0.11",
        "postcss-easy-import": "3.0.0"
    },
    "config": {
        "posts_per_page": 15,
        "image_sizes": {
            "xs": {
                "width": 100
            },
            "s": {
                "width": 300
            },
            "m": {
                "width": 600
            },
            "l": {
                "width": 1200
            },
            "xl": {
                "width": 2000
            }
        },
        "card_assets": {
            "exclude": ["button", "header"]
        }
    }
}
